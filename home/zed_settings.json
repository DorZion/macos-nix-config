// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "left",
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
      "default_mode": "plan",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "soft_wrap": "none",
  "text_rendering_mode": "platform_default",
  "ui_font_size": 14.0,
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "show_signature_help_after_edits": true,
  "auto_signature_help": false,
  "search": {
    "include_ignored": false,
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },
  "confirm_quit": true,
  "base_keymap": "VSCode",
  "disable_ai": false,
  "context_servers": {
    "atlassian": {
      "enabled": false,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/sse"],
    },
  },
  "debugger": {
    "dock": "bottom",
  },
  "restore_on_startup": "last_session",
  "show_edit_predictions": true,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
    "model_parameters": [],
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-5-thinking-latest",
    },
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
  },
  "helix_mode": false,
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
  },
  "ui_font_family": "CommitMono",
  "ui_font_features": {
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "cv01": false,
    "cv02": false,
    "cv04": false,
    "cv08": true,
    "cv10": true,
  },
  "buffer_font_family": "CommitMono",
  "buffer_font_size": 12.0,
  "buffer_line_height": "standard",
  "buffer_font_features": {
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "cv01": false,
    "cv02": false,
    "cv04": false,
    "cv08": true,
    "cv10": false,
  },
  "cursor_blink": false,
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "autosave": "on_window_change",
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": false,
    "show_background": false,
    "show_value_hints": false,
    "show_parameter_hints": true,
    "toggle_on_modifiers_press": {
      "function": true,
    },
  },
  "tab_size": 2,
  "languages": {
    "Proto": {
      "formatter": [
        {
          "external": {
            "command": "/etc/profiles/per-user/dor/bin/clang-format",
            "arguments": ["--style=file", "--assume-filename={buffer_path}"],
          },
        },
      ],
    },
    "Python": {
      "language_servers": [
        "ty",
        "ruff",
        "!basedpyright",
        "!pyrefly",
        "!pyright",
        "!pylsp",
      ],
      "enable_language_server": true,
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },
  "file_scan_inclusions": [
    ".env*",
    "docker-compose.*.yml",
    "*.local*",
    "config.(yaml|yml|json)",
    ".zed",
  ],
  "show_whitespaces": "boundary",
  "preview_tabs": {
    "enabled": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.1,
  },
  "minimap": {
    "show": "auto",
  },
  // "experimental.theme_overrides": {
  //   "players": [
  //     {
  //       "cursor": "#ffff",
  //     },
  //   ],
  // },
}
